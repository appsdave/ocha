{
  "name": "ocha",
  "version": "1.0.0",
  "description": "Multi-agent orchestration for Junie — decompose tasks, spawn AI coding agents in isolated git worktrees, and coordinate parallel work",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "ocha": "./bin/ocha.js"
  },
  "scripts": {
    "test": "node --test --test-reporter=./src/lib/test-reporter.js test/**/*.test.js",
    "lint": "eslint src/ bin/",
    "lint:fix": "eslint src/ bin/ --fix",
    "format": "prettier --write 'src/**/*.js' 'bin/**/*.js'",
    "format:check": "prettier --check 'src/**/*.js' 'bin/**/*.js'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appsdave/ocha.git"
  },
  "keywords": [
    "junie",
    "multi-agent",
    "orchestration",
    "git-worktree",
    "ai",
    "cli"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/appsdave/ocha/issues"
  },
  "homepage": "https://github.com/appsdave/ocha#readme",
  "dependencies": {
    "blessed": "^0.1.81",
    "blessed-contrib": "^4.11.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "ora": "^9.3.0"
  },
  "devDependencies": {
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1"
  }
}
